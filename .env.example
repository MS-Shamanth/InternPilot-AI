# Copy to .env and adjust. Placeholders only; never commit real secrets.
# Backend settings are read by backend/app/core/config.py (design.md §13.1).
# List values accept a comma list (a,b) or JSON (["a","b"]).

# ---------- Backend ----------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Directory holding seed_*.json and ingest/*.json (default <repo>/data; Docker uses /data)
DATA_DIR=./data
# REQUIRED: the backend refuses to start without it.
# This localhost URL is for a backend run on the host. Under docker compose the backend
# container ignores it: compose sets DATABASE_URL to the `db` service (design.md §18).
DATABASE_URL=postgresql+psycopg://internpilot:change-me@localhost:5432/internpilot
# Tests: defaults to in-memory SQLite if unset; set to Postgres to run integration tests there
TEST_DATABASE_URL=postgresql+psycopg://internpilot:change-me@localhost:5432/internpilot_test
# Explicit http(s) origins only; wildcards are rejected
CORS_ORIGINS=http://localhost:5173

# ---------- docker compose ----------
# Required by docker-compose.yml (compose refuses to start without them). The backend container
# builds its DATABASE_URL from these, so use URL-safe characters (letters, digits, - _ .).
POSTGRES_USER=internpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=internpilot
# Host ports, bound to 127.0.0.1 only
POSTGRES_PORT=5432
BACKEND_PORT=8000
# The SPA's browser origin is http://localhost:<FRONTEND_PORT>; keep CORS_ORIGINS in sync
FRONTEND_PORT=5173

# Demo user (lightweight, NOT production auth). The email is only the seeded user's initial
# email; the demo user is resolved by its seed key, so editing the profile email is safe.
DEMO_USER_EMAIL=demo@internpilot.dev
DEMO_USER_NAME=Demo Student

# Job ingestion (public, no-auth sources only; exact-match host allow-list)
INGEST_ALLOWED_HOSTS=remotive.com,www.arbeitnow.com
# 1-60 seconds
INGEST_TIMEOUT_SECONDS=10
INGEST_MAX_BYTES=5000000

# Optional LLM provider (disabled by default; only enriches interview questions)
LLM_ENABLED=false
# openai_compatible is the only supported value
LLM_PROVIDER=openai_compatible
# http(s) URL or empty
LLM_BASE_URL=
# Secret; never logged
LLM_API_KEY=change-me
LLM_MODEL=

# ---------- Frontend ----------
# Public (inlined into the JS bundle at build time; never put a secret in VITE_*). Used by
# `npm run dev`/`npm run build` and as the compose frontend build arg; rebuild after changing.
VITE_API_BASE_URL=http://localhost:8000/api
